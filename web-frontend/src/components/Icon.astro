---
import { ICONS, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const { paint, body } = ICONS[name];
const paintAttrs = typeof paint === 'number'
  ? { fill: 'none', stroke: 'currentColor', 'stroke-width': paint, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const
  : { fill: 'currentColor' } as const;
---
<svg class={className} viewBox="0 0 24 24" {...paintAttrs} aria-hidden="true" set:html={body} />
