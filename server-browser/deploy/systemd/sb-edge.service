[Unit]
Description=Reboot server browser edge (QUIC)
Documentation=https://github.com/Auties00/Reboot-Launcher/tree/dev/server-browser
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/sb-edge --config /etc/sb/edge.toml
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM drains: leave DNS rotation, GoAway every client, wait for them to move.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=2

User=sb-edge
Group=sb-edge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
LimitMEMLOCK=infinity

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/sb /etc/letsencrypt

[Install]
WantedBy=multi-user.target
